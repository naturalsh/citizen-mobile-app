# Gemini API key for the embedded 112 Voice Agent brain (brain/)
GEMINI_API_KEY=

# Optional model & behaviour overrides (defaults match Voice_Agents)
BRAIN_LIVE_MODEL=gemini-2.5-flash-lite
BRAIN_BACKUP_MODEL=gemini-2.5-flash
BRAIN_REPORT_MODEL=gemini-2.5-flash-lite
BRAIN_THINKING_LEVEL=minimal
BRAIN_OPERATOR_LANG=auto
BRAIN_MASKING=on
BRAIN_OUTPUT_DIR=output
