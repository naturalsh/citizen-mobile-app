# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional overrides
BRAIN_LIVE_MODEL=gemini-3.5-flash-lite
BRAIN_REPORT_MODEL=gemini-3.5-flash-lite
BRAIN_THINKING_LEVEL=minimal
BRAIN_OPERATOR_LANG=auto  # auto = the caller's language if Greek or Turkish, else Turkish for +90 numbers, otherwise Greek
BRAIN_MASKING=on  # hide names, addresses and numbers from the model
BRAIN_PLACE_CHECK=on  # look the caller's area (and street name, never the house number) up on OpenStreetMap during the call
BRAIN_HANDOFF_MODE=surge  # surge: only urgent cases go to a person; normal: anything outside a disaster call too. The dashboard switch overrides it
BRAIN_BACKUP_MODEL=gemini-3.5-flash  # asked when the live model is slow or busy (own quota)
BRAIN_MODEL_TIMEOUT_S=4  # seconds to wait for the live model before asking the backup
# Spending protection (brain/budget.py): above these the brain stops calling Gemini and hands callers to an operator
BRAIN_MAX_REQUESTS_PER_HOUR=300
BRAIN_MAX_REQUESTS_PER_DAY=1500
BRAIN_LIMIT_NOTIFY=on  # macOS notification when the limit activates, at 80%, and when it lifts

# WhatsApp channel (channels/README.md)
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=

# Failed-112-call trigger (channels/README.md). Without the Twilio values it runs as a dry run.
TRIGGER_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=+14155238886

# Voice calls (voice/README.md). `python -m voice.check` shows which of these are still missing.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SONIOX_API_KEY=
CARTESIA_API_KEY=
VOICE_TTS=cartesia  # cartesia, azure or elevenlabs
# One Cartesia voice ID per language, from the Cartesia dashboard. Empty = Cartesia's default voice.
CARTESIA_VOICE_EL=
CARTESIA_VOICE_TR=
CARTESIA_VOICE_EN=
CARTESIA_VOICE_FR=
# Only for VOICE_TTS=elevenlabs. Voice IDs from ElevenLabs -> Voices (e.g. your own Greek clone). Empty = default voice.
ELEVENLABS_API_KEY=  # set for you by: npx -y @elevenlabs/cli@latest onboard init
ELEVENLABS_VOICE_EL=
ELEVENLABS_VOICE_TR=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_FR=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.6  # lower = more expressive, higher = steadier and calmer (0.45 sounded angry at sentence ends)
ELEVENLABS_SPEED=0.9  # a little slower than normal, clearer on a phone line (0.7-1.2); re-run voice.prerecord after changing it
BRAIN_STREET_LIST=on  # fetch each area's real street names (OpenStreetMap Overpass, only the area's box is sent) to suggest the street a caller meant
OVERPASS_URL=  # empty = three public servers, tried in turn; or your own, comma-separated
BRAIN_LOCAL_OSM=on  # street lists and house numbers from the local index (brain/osm_index.py) when it is built; off = Overpass
OSM_INDEX=output/osm/index.sqlite  # set up with: .venv/bin/python -m brain.osm_index setup
DASHBOARD_GEOCODE=on  # look up area names on OpenStreetMap for the dashboard map (dashboard/README.md)
DASHBOARD_HOUSE_NUMBERS=on  # pin or estimate the building from house numbers mapped near the street (Overpass gets only a box, never the number); off = street-only pins
DASHBOARD_ACCESS_KEY=  # key in the --share link (dashboard/README.md); empty = a random key kept in output/dashboard_share_key
MESSAGING_DASHBOARD=http://127.0.0.1:8003  # the messaging server's address also shows the shared dashboard, behind its key (channels/dashboard_proxy.py); off = not shown
VOICE_RECORDINGS=on  # play pre-recorded fixed lines (python -m voice.prerecord); off = speak everything live
# Only for VOICE_TTS=azure. Voices default to el-GR-AthinaNeural, tr-TR-EmelNeural, en-GB-SoniaNeural, fr-FR-DeniseNeural.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE_EL=
AZURE_VOICE_TR=
AZURE_VOICE_EN=
AZURE_VOICE_FR=
# Optional overrides
SONIOX_MODEL=stt-rt-v5
# Only for an EU-region Soniox project: SONIOX_BASE_URL=wss://stt-rt.eu.soniox.com/transcribe-websocket
SONIOX_BASE_URL=
CARTESIA_MODEL=sonic-3
VOICE_TEST_PHONE=+30 690 000 0000  # caller number for browser/console calls; +90 to test Turkish
VOICE_LANG_MIN_LETTERS=12  # a sentence needs this many letters before the call switches language
VOICE_KEYWORDS=on  # boost disaster terms and place names in speech-to-text (voice/keywords.json)
VOICE_STREET_HINTS=on  # add the caller's area streets to the speech-to-text hints mid-call (reconnects Soniox between turns)
VOICE_MAX_CALLS=3  # this computer takes no new call at this many calls at once (voice/load.py)
VOICE_CPU_LIMIT=0.95  # ...or when the CPU stays above this share; LiveKit's own rule stopped at 70%, e.g. while recording the screen
# Phone calls (voice/README.md, "Phone calls"). Empty OPERATOR_NUMBER = hang up after the handoff line.
OPERATOR_NUMBER=
VOICE_NOISE_CANCELLATION=on  # LiveKit Cloud only; off on a self-hosted LiveKit server
VOICE_STREAM_REPLIES=on  # speak the reply while the brain is still writing it; off = wait for all of it
VOICE_HOLD_AFTER_S=2.5  # say "one moment" if the caller hears nothing for this long; 0 = never
VOICE_TURN_DETECTION=stt  # caller's turn ends on Soniox's endpoint detection; vad = 0.5 s of silence; livekit = LiveKit's default
SONIOX_MAX_ENDPOINT_DELAY_MS=1500  # longest wait after speech before the turn ends, 500-3000
SONIOX_ENDPOINT_SENSITIVITY=0.0  # -1..1; lower = waits longer through pauses and fillers, 0 = Soniox's default
SONIOX_ENDPOINT_LATENCY_LEVEL=0  # 0-3; higher = ends turns sooner (not with a negative sensitivity)
VOICE_LOG_HEARD=on  # log every sentence speech-to-text hears (stays on this machine); off for real callers
VOICE_FILLER_FILTER=on  # ignore turns that are only "εε"/"um" and strip fillers before the brain (voice/fillers.json)
